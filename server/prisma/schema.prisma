generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Spot {
  id        Int      @id @default(autoincrement())
  name      String
  lat       Float
  lng       Float
  hasLight  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}